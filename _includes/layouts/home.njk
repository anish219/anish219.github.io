{% extends "layouts/base.njk" %}
{% block main %}
<section class="intro" id="about" aria-label="About Anish">
  <aside class="sidebar">
    <img class="profile-photo" src="{{ site.profile_photo }}" alt="{{ site.name }}'s GitHub profile photo">
    <div class="identity">{{ site.name }}</div>
    <p>{{ site.location }}</p>
    <p>{{ site.education }}</p>
    <div class="sidebar-links">{% for link in site.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div>
  </aside>
  <div class="intro-copy"><h1>{{ headline }}</h1>{{ content | safe }}</div>
</section>

<section class="section" id="news">
  <h2>News</h2>
  <ul class="news-list">{% for item in collections.news %}<li><strong>[{{ item.data.date_label }}]</strong> {{ item.templateContent | safe }}</li>{% endfor %}</ul>
</section>

<section class="section" id="projects">
  <div class="projects-heading">
    <h2>Projects</h2>
    <div class="project-view-switch" role="group" aria-label="Project view">
      <button type="button" data-project-view="cards" aria-controls="project-cards" aria-pressed="true">Cards</button>
      <button type="button" data-project-view="timeline" aria-controls="project-timeline" aria-pressed="false">Timeline</button>
    </div>
  </div>
  <div class="project-card-grid" id="project-cards">
    {% for project in collections.projects %}
    <article class="project-card">
      <a class="project-card-image{% if project.data.card_video %} project-card-video{% endif %}" href="{{ project.url }}" aria-label="{{ project.data.list_title or project.data.title }} project note">
        {% if project.data.card_video %}<video muted loop playsinline preload="none" poster="{{ project.data.card_video_poster }}" data-card-video aria-hidden="true"><source src="{{ project.data.card_video }}" type="video/mp4"></video>
        {% else %}<img src="{{ project.data.card_image }}" alt="{{ project.data.card_image_alt }}" loading="lazy" decoding="async"{% if project.data.card_image_position %} style="object-position:{{ project.data.card_image_position }}"{% endif %}>{% endif %}
      </a>
      <div class="project-card-content">
        <div class="project-card-year">{{ project.data.when }}</div>
        <h3><a href="{{ project.url }}">{{ project.data.list_title or project.data.title }}</a></h3>
        <p class="summary">{{ project.data.list_summary or project.data.summary }}</p>
        <p class="context">{{ project.data.context }}</p>
        <p class="links"><a href="{{ project.url }}">[project note]</a>{% for link in project.data.links %}<a href="{{ link.url }}">[{{ link.label }}]</a>{% endfor %}</p>
      </div>
    </article>
    {% endfor %}
  </div>
  <div id="project-timeline" hidden>
  {% for group in collections.projectGroups %}
  <h3 class="year">{{ group.label }}</h3>
  {% for project in group.projects %}
  <article class="entry"><div class="when">{{ project.data.when }}</div><div>
    <h3><a href="{{ project.url }}">{{ project.data.list_title or project.data.title }}</a></h3>
    <p class="summary">{{ project.data.list_summary or project.data.summary }}</p>
    <p class="context">{{ project.data.context }}</p>
    <p class="links"><a href="{{ project.url }}">[project note]</a>{% for link in project.data.links %}<a href="{{ link.url }}">[{{ link.label }}]</a>{% endfor %}</p>
  </div></article>
  {% endfor %}{% endfor %}
  </div>
</section>

<section class="section" id="writing">
  <h2>Writing</h2>
  {% for post in collections.writing %}<article class="entry"><div class="when">{{ post.data.date_label }}</div><div><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p class="summary">{{ post.data.summary }}</p></div></article>{% endfor %}
  {% for project in collections.projects %}{% if project.data.writing_featured %}<article class="entry"><div class="when">{{ project.data.when }}</div><div><h3><a href="{{ project.url }}">{{ project.data.writing_title or project.data.title }}</a></h3><p class="summary">{{ project.data.writing_summary or project.data.summary }}</p></div></article>{% endif %}{% endfor %}
</section>
{% endblock %}
