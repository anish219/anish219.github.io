{% extends "layouts/base.njk" %}
{% block main %}
  <div class="eyebrow">{{ eyebrow }}</div><h1>{{ title }}</h1>
  {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  {% if meta %}<p class="meta">{{ meta }}{% for link in site.links %} · <a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</p>{% endif %}
  {{ content | safe }}
{% endblock %}
